DATABASE_URL="postgres://user:password@localhost:5432/locallens?sslmode=disable"

# JWT Configuration
JWT_ACCESS_SECRET="your-access-secret-key"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="your-refresh-secret-key"
JWT_REFRESH_EXPIRES_IN="7d"

# Frontend URL (used for SSLCommerz redirects after payment)
FRONTEND_URL="http://localhost:3000"

# SSLCommerz Configuration
SSL_STORE_ID="your_store_id"
SSL_STORE_PASS="your_store_password"
SSL_PAYMENT_API="https://sandbox.sslcommerz.com/gwprocess/v4/api.php"
SSL_VALIDATION_API="https://sandbox.sslcommerz.com/validator/api/validationserverAPI.php"

# Backend callback URLs — SSLCommerz calls these (must be publicly accessible)
SSL_SUCCESS_BACKEND_URL="http://localhost:4000/payments/success"
SSL_FAIL_BACKEND_URL="http://localhost:4000/payments/fail"
SSL_CANCEL_BACKEND_URL="http://localhost:4000/payments/cancel"
SSL_IPN_URL="http://localhost:4000/payments/ipn"
