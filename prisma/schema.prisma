// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  TOURIST
  ADMIN
  GUIDE
}

enum TOUR_CATEGORY {
  FOOD
  HISTORICAL
  ART
  NATURE
  ADVENTURE
  CULTURAL
}

enum TOUR_STATUS {
  ACTIVE
  DEACTIVATE
}

enum BOOKING_STATUS {
  PENDING
  ACCEPTED
  PAYMENT_PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  FAILED
}

enum PAYMENT_STATUS {
  PAID
  UNPAID
  CANCELLED
  FAILED
  REFUNDED
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  phone     String
  address   String   @default("")
  role      Role     @default(TOURIST)
  language  String   @default("en")
  isActive  Boolean  @default(true)
  isDeleted Boolean  @default(false)
  isBlocked Boolean  @default(false)
  image              String?
  hashedRefreshToken String?
  createdAt          DateTime @default(now())
  updatedAt DateTime @updatedAt

  tours          Tour[]
  bookings       Booking[] @relation("UserBookings")
  guidedBookings Booking[] @relation("GuideBookings")
}

model Tour {
  id              Int           @id @default(autoincrement())
  slug            String        @unique
  guideId         Int
  guide           User          @relation(fields: [guideId], references: [id], onDelete: Restrict)
  title           String
  description     String
  longDescription String?       @db.Text
  itinerary       Json          @default("[]")
  tourFee         Float
  maxDuration     Int
  meetingPoint    String
  maxGroupSize    Int
  category        TOUR_CATEGORY
  location        String
  images          String[]
  highlights      String[]
  included        String[]
  notIncluded     String[]
  importantInfo   String[]
  status          TOUR_STATUS   @default(ACTIVE)
  active          Boolean       @default(true)
  isFeatured      Boolean       @default(false)
  availableDates Json          @default("[]")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  bookings Booking[]
}

model Booking {
  id             Int            @id @default(autoincrement())
  userId         Int
  user           User           @relation("UserBookings", fields: [userId], references: [id], onDelete: Restrict)
  tourId         Int
  tour           Tour           @relation(fields: [tourId], references: [id], onDelete: Cascade)
  guideId        Int
  guide          User           @relation("GuideBookings", fields: [guideId], references: [id], onDelete: Restrict)
  bookingDate    DateTime
  bookingTime    String
  numberOfGuests Int
  totalAmount    Float
  status         BOOKING_STATUS @default(PENDING)
  note           String?        // cancellation / failure / guide note
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  payment Payment?
}

model Payment {
  id                 Int            @id @default(autoincrement())
  bookingId          Int            @unique
  booking            Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  transactionId      String         @unique
  amount             Float
  status             PAYMENT_STATUS @default(UNPAID)
  paymentGatewayData Json?          // Raw SSLCommerz response stored for records
  paidAt             DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
}