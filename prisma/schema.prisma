// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  TOURIST
  ADMIN
  GUIDE
}

enum TOUR_CATEGORY {
  FOOD
  HISTORICAL
  ART
  NATURE
  ADVENTURE
  CULTURAL
}

enum TOUR_STATUS {
  ACTIVE
  DEACTIVATE
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(TOURIST)
  language  String   @default("en")
  isActive  Boolean  @default(true)
  isDeleted Boolean  @default(false)
  isBlocked Boolean  @default(false)
  image              String?
  hashedRefreshToken String?
  createdAt          DateTime @default(now())
  updatedAt DateTime @updatedAt

  tours          Tour[]
}

model Tour {
  id              Int           @id @default(autoincrement())
  slug            String        @unique
  guideId         Int
  guide           User          @relation(fields: [guideId], references: [id], onDelete: Restrict)
  title           String
  description     String
  longDescription String?       @db.Text
  itinerary       Json          @default("[]")
  tourFee         Float
  maxDuration     Int
  meetingPoint    String
  maxGroupSize    Int
  category        TOUR_CATEGORY
  location        String
  images          String[]
  highlights      String[]
  included        String[]
  notIncluded     String[]
  importantInfo   String[]
  status          TOUR_STATUS   @default(ACTIVE)
  active          Boolean       @default(true)
  isFeatured      Boolean       @default(false)
  availableDates Json          @default("[]")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

}